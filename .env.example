# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY:
# Single unified key for all Google Maps Platform services (Maps JS, Places, Roads, Routes, Street View, Geocoding).
# Configure this in Settings / Environment Variables in Google AI Studio.
GOOGLE_MAPS_API_KEY=""

# SPEECHMATICS_API_KEY:
# Required for Speechmatics Realtime SDK (STT) and Text-To-Speech (TTS).
# Configure this in Settings / Environment Variables in Google AI Studio.
SPEECHMATICS_API_KEY=""

# VITE_FIREBASE_API_KEY:
# Required for Firebase Authentication, Firestore, and other Firebase services.
# Configure this in Settings / Environment Variables in Google AI Studio.
VITE_FIREBASE_API_KEY=""

# VITE_FIREBASE_AUTH_DOMAIN:
# Firebase project auth domain (e.g., your-project.firebaseapp.com).
VITE_FIREBASE_AUTH_DOMAIN=""

# VITE_FIREBASE_PROJECT_ID:
# Firebase project ID.
VITE_FIREBASE_PROJECT_ID=""

# VITE_FIREBASE_STORAGE_BUCKET:
# Firebase storage bucket URL.
VITE_FIREBASE_STORAGE_BUCKET=""

# VITE_FIREBASE_MESSAGING_SENDER_ID:
# Firebase Cloud Messaging sender ID.
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# VITE_FIREBASE_APP_ID:
# Firebase web app ID.
VITE_FIREBASE_APP_ID=""

# VITE_FIREBASE_MEASUREMENT_ID:
# Google Analytics measurement ID for Firebase.
VITE_FIREBASE_MEASUREMENT_ID=""

# ONE_MAP_EMAIL / ONE_MAP_PASSWORD:
# Optional. OneMap SG (Singapore Land Authority) developer credentials for
# sheltered-walkway routing. Without them, OneMap address search still works
# but /api/onemap/route returns success:false.
ONE_MAP_EMAIL=""
ONE_MAP_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
